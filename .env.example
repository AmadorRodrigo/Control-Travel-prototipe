APP_ENV=development
ENABLE_DOCS=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

POSTGRES_DB=travel_manager
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_password

DATABASE_URL=postgresql+psycopg2://travel_user:travel_password@postgres:5432/travel_manager
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_PAGE_SIZE=50
DEFAULT_PAGE_SIZE=10
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_USERNAME_RATE_LIMIT_PER_MINUTE=5
AUTHENTICATED_READ_RATE_LIMIT_PER_MINUTE=60
AUTHENTICATED_WRITE_RATE_LIMIT_PER_MINUTE=20
IDEMPOTENCY_TTL_MINUTES=10
REFRESH_COOKIE_NAME=travel_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!
FRONTEND_PROD_PORT=80
